{
  "name": "react-post-composer-validation",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "docker:build": "docker build -t personal-brand:latest .",
    "docker:run": "docker run -d -p 3000:80 --name personal-brand-app personal-brand:latest",
    "docker:stop": "docker stop personal-brand-app && docker rm personal-brand-app",
    "docker:compose": "docker compose up --build -d",
    "docker:compose:down": "docker compose down",
    "docker:dev": "docker compose --profile dev up --build"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.10",
    "@clerk/react": "^6.17.2",
    "lucide-react": "^0.439.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "redis": "^6.2.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.0"
  }
}
