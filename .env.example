# ==============================================================================
# Post Composer Pro — Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development with official APIs.
# In Demo Mode (default), all social publishing, analytics, and authentication
# operate safely offline without requiring any external paid credentials.
# ==============================================================================

# Application URL
APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# Clerk Authentication (Linked App ID: app_2x4ppxeV4SGTzXnsNcxbK8HRpSB)
# ------------------------------------------------------------------------------
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ------------------------------------------------------------------------------
# Supabase Production Backend (Auth, Database, Storage)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-Side Supabase Service Key (Never expose with VITE_ prefix!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Meta Graph API (Instagram Business & Facebook Pages)
# ------------------------------------------------------------------------------
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=http://localhost:5173/auth/meta/callback

# ------------------------------------------------------------------------------
# LinkedIn Developer API (Company Pages & Member Profiles)
# ------------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:5173/auth/linkedin/callback

# ------------------------------------------------------------------------------
# X (Formerly Twitter) API v2 (OAuth 2.0 User Context)
# ------------------------------------------------------------------------------
X_CLIENT_ID=your-x-client-id
X_CLIENT_SECRET=your-x-client-secret
X_REDIRECT_URI=http://localhost:5173/auth/x/callback

# ------------------------------------------------------------------------------
# Google Cloud / YouTube Data API v3
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
